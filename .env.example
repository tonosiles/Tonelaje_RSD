# ─── Obligatorias en producción ────────────────────────────────────────────
# Clave para firmar las sesiones (mínimo 32 caracteres aleatorios).
SESSION_SECRET=
# Administrador inicial: se crea solo si todavía no existe ningún usuario.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ─── Lectura con IA (Claude) ──────────────────────────────────────────────
# Sin esta clave la app funciona en modo de prueba con datos simulados.
ANTHROPIC_API_KEY=
# Opcionales:
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium   # low | medium | high

# ─── Almacenamiento ───────────────────────────────────────────────────────
# "sheets" (Google Sheets + Drive) o "local" (archivos en .data/, solo para pruebas).
# Si no se define, se usa "sheets" cuando existe GOOGLE_SHEETS_ID.
# STORAGE_BACKEND=sheets

# ID de la planilla (lo que va entre /d/ y /edit en su URL).
GOOGLE_SHEETS_ID=
# Nombre de la hoja donde se guardan los tickets (por defecto "Tickets").
# GOOGLE_SHEETS_TAB=Tickets
# Fotos: la app crea sola una carpeta "Vouchers - fotos (app)" en su Drive.
# Solo defina un ID de carpeta si usa cuenta de servicio con unidad compartida.
# GOOGLE_DRIVE_FOLDER_NAME=Vouchers - fotos (app)
# GOOGLE_DRIVE_FOLDER_ID=

# Opción A (recomendada con cuentas @gmail.com): OAuth de su cuenta Google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Opción B: cuenta de servicio (JSON completo o en base64). Para subir fotos a Drive
# necesita una unidad compartida de Google Workspace.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Zona horaria para "hoy" y "este mes".
NEXT_PUBLIC_TIMEZONE=America/Santiago
